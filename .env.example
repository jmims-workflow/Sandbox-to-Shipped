ANTHROPIC_API_KEY=
# demo (sample data, no key), live (saves, needs a key) or preview (real Claude, nothing saved, needs a key)
STS_MODE=demo
STS_MODEL=claude-sonnet-5-5
DATA_DIR=./data
# How many working days reviewers usually take to answer. Shown on "Here's what happens next".
STS_REVIEW_DAYS=5
# How many tools can be in pilot at once. Approvals wait while every slot is in use.
STS_PILOT_SLOTS=3
# Live preview limits on Claude calls: a daily total (resets at midnight UTC) and a per-visitor hourly limit.
STS_DAILY_CLAUDE_CALLS=100
STS_VISITOR_CLAUDE_CALLS_PER_HOUR=10
# Development only. 1 makes live mode use a stand-in for Claude (no key, no network), for the recorded
# walkthrough. The app refuses to start with it in demo or preview mode, or when ANTHROPIC_API_KEY is set.
# STS_FAKE_CLAUDE=1
